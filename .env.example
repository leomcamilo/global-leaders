# Copy to .env and fill in. The demo auto-loads .env (see scripts/play_demo.py).

# Ollama Cloud (default backend) — create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional overrides:
# OLLAMA_MODEL=nemotron-3-nano:30b
# OLLAMA_HOST=https://ollama.com
#
# ── OFF THE GRID — fully local, NO key, nothing leaves your machine ──
# 1) install Ollama (https://ollama.com) and pull a small model, e.g.:
#       ollama pull nemotron-mini          # or any <=32B model: qwen3, gemma3, llama3.2 ...
# 2) uncomment BOTH lines below (set OLLAMA_MODEL to exactly what you pulled):
#   OLLAMA_HOST=http://localhost:11434
#   OLLAMA_MODEL=nemotron-mini
# No API key is needed in local mode. The app pre-checks that Ollama is running and the
# model is pulled, and tells you what to fix if not.

# OpenRouter (alternative backend) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2
