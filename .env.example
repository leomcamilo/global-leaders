# Copy to .env and fill in. The app auto-loads .env.

# ── HOW TO PLAY: OFF THE GRID — local NVIDIA Nemotron, NO key, nothing leaves your machine ──
# 1) install Ollama (https://ollama.com) and pull the model:
#       ollama pull nemotron-3-nano:30b      # the 30B Nemotron this game targets
#                                            # (any <=32B model works too: qwen3, gemma3 ...)
# 2) uncomment BOTH lines below (set OLLAMA_MODEL to exactly what you pulled):
#   OLLAMA_HOST=http://localhost:11434
#   OLLAMA_MODEL=nemotron-3-nano:30b
# No API key needed. The app pre-checks that Ollama is running and the model is pulled,
# and tells you what to fix if not. The header shows "local Ollama".

# ── OPTIONAL: Ollama Cloud ──
# Only needed for the curation scripts (scripts/research_country.py, generate_personas.py),
# or if you'd rather not run locally. Create a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=
# OLLAMA_HOST=https://ollama.com
# OLLAMA_MODEL=nemotron-3-nano:30b

# ── OPTIONAL: OpenRouter (alternative backend) — https://openrouter.ai/keys ──
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2
